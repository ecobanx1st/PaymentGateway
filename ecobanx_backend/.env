# HD wallet master mnemonic (generated once, do not change)
MASTER_MNEMONIC=
 
 
 # buyer configuration
CHECKOUT_TIMEOUT_SECONDS=900
CHECKOUT_TIMEOUT_SECONDSs=900s
 
# EVM watcher + tracker (backend port of evm-track)
EVM_WATCHER_ENABLED=true
EVM_TRACKER_URL=http://localhost:3002
ADMIN_WALLET_SWEEP_URL=http://localhost:3002
EVM_TRACKER_TIMEOUT_MS=5000
SERVICE_WALLET_ETH_ID=
SERVICE_WALLET_ETH_PRIVATE_KEY_PATH=
PRICE_QUOTE_TTL_SECONDS=900
WEB3_PROVIDER=
QUICKNODE_HTTP=
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_SECRET_PATH=
ADMINADDRESS=
ADMINPRIVATEKEY=
 
# EVM balance sweep cron
EVM_BALANCE_CRON_ENABLED=true
EVM_BALANCE_CRON_EXPR=*/5 * * * *
EVM_BALANCE_MIN_SWEEP=0.000001
EVM_BALANCE_MAX_PER_TICK=5
EVM_BALANCE_BATCH=20
EVM_BALANCE_DRY_RUN=false
EVM_BALANCE_RETRY_MS=60000
# native (default) = sweep in-process with web3, http = call evm-track API, auto = local then HTTP fallback
EVM_TRACKER_SWEEP_MODE=native
# user wallet addresses (WalletAddress) that receive deposits have no chain attached -> probe them too
EVM_BALANCE_INCLUDE_WALLET_ADDRESSES=true
EVM_BALANCE_WALLET_BATCH=3
# comma-separated networkSymbol allow-list for wallet addresses (empty = all EVM networks)
EVM_BALANCE_WALLET_SYMBOLS=ETH
# network tag the eth-cron block scanner attaches to deposits; must match
# Network.networkSymbol for the scanned chain (ETH = Sepolia entry)
WEB3_CHAIN=ETH
ORIGINALURL=