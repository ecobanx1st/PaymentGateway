PORT=3700
NODE_ENV=development
USE_REDIS=true
MONGO_URI=
SMTP_HOST=
SMTP_PORT=
SMTP_PASSWORD=
EMAIL_FROM_NAME=Ecobanx
EMAIL_FROM_ADDRESS=ecobanx@gmail.com
BREVO_API_KEY=
PASETO_PRIVATE_KEY=
PASETO_PUBLIC_KEY=
ENCRYPTION_KEY=
BACKEND_URL=http://localhost:3700/ecobanxApi
IMAGE_URL=http://localhost:3700/ecobanxApi


login_max_min_allowed=900
 
 
# Login Rate Limit
ACCOUNT_LOCK_MINUTES=2
max_attempts=5
 
# Rate limit

#Without token API HIT
MAX_REQ_ALLOWED_WITHOUT_AUTH=10
RATE_LIMIT_DURATION_WITHOUT_AUTH=1
 
# With token API HIT
MAX_REQ_ALLOWED_WITH_AUTH=2000
RATE_LIMIT_DURATION_WITH_AUTH=10
 

#  token configuration
Accesstoken=2h
RefreshToken=7d



