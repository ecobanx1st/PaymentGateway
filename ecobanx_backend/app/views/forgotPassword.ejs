<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Your Password</title>
</head>

<body
    style="margin:0;padding:0;background-color:#F8F5FF;font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased;">

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
        style="background:#F8F5FF;padding:40px 15px;">

        <tr>
            <td align="center">

                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                    style="max-width:600px;background:#FFFFFF;border-radius:18px;overflow:hidden;border:1px solid #E7DDFC;box-shadow:0 12px 35px rgba(5,0,255,.12);">

                    <!-- Header -->
                    <tr>
                        <td align="center"
                            style="background:linear-gradient(135deg,#130D1E 0%,#0500FF 100%);padding:40px 30px;">

                            <div style="font-size:30px;font-weight:bold;color:#FFFFFF;letter-spacing:0.5px;">
                                Eco Banx
                            </div>

                            <div style="margin-top:8px;font-size:13px;color:#E9DFFF;">
                                Secure Payment Solutions
                            </div>

                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding:40px 35px;">

                            <h1 style="margin:0 0 18px;font-size:28px;color:#130D1E;">
                                Reset Your Password
                            </h1>

                            <p style="margin:0 0 15px;font-size:15px;line-height:1.8;color:#4B5563;">

                                Hello
                                <strong style="color:#130D1E;">
                                    <%= typeof name !=='undefined' && name ? name : 'there' %>
                                </strong>,

                            </p>

                            <p style="margin:0 0 28px;font-size:15px;line-height:1.8;color:#4B5563;">

                                We received a request to reset your
                                <strong style="color:#0500FF;">Eco Banx</strong>
                                account password.

                                Please use the One-Time Password (OTP) below to
                                continue with your password reset.

                            </p>

                            <!-- OTP -->
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0">

                                <tr>
                                    <td align="center">

                                        <div style="
                                            display:inline-block;
                                            background:#F4ECFF;
                                            border:2px solid #0500FF;
                                            border-radius:14px;
                                            padding:18px 48px;
                                            color:#130D1E;
                                            font-size:36px;
                                            font-weight:bold;
                                            letter-spacing:10px;
                                            box-shadow:0 6px 20px rgba(5,0,255,.15);">

                                            <%= otp %>

                                        </div>

                                    </td>
                                </tr>

                            </table>

                            <!-- OTP Expiry -->
                            <div style="
                                margin-top:28px;
                                background:#F4ECFF;
                                border-left:5px solid #0500FF;
                                padding:16px 20px;
                                border-radius:10px;">

                                <p style="
                                    margin:0;
                                    color:#130D1E;
                                    font-size:14px;
                                    font-weight:bold;
                                    line-height:1.6;">

                                    ⏱ This OTP is valid for only <strong>3 minutes</strong>.

                                </p>

                            </div>



                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="background:#130D1E;padding:28px;">

                            <p style="
                                margin:0;
                                font-size:13px;
                                line-height:24px;
                                color:#D8C8FF;">

                                © <%= new Date().getFullYear() %>

                                    <strong style="color:#FFFFFF;">
                                        Eco Banx
                                    </strong>

                                    <br>

                                    Secure • Fast • Reliable

                            </p>

                        </td>
                    </tr>

                </table>

            </td>
        </tr>

    </table>

</body>

</html>
```
